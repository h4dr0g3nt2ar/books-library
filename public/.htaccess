# Включаем модуль перезаписи
RewriteEngine On

# Если запрошенный файл существует (например, картинка или css) — отдаём его
RewriteCond %{REQUEST_FILENAME} !-f

# Если запрошенная директория существует — отдаём её
RewriteCond %{REQUEST_FILENAME} !-d

# Всё остальное перенаправляем на index.php
RewriteRule ^ index.php [QSA,L]